# HairFit BYOK — copy to .env and fill in the keys you use.

# --- 一行切换模型（可选）：设了 PROVIDER 就整段走该厂商，model 自动用默认值 ---
# HAIRFIT_ANALYSIS_PROVIDER=zhipu          # openai/anthropic/deepseek/qwen/zhipu/doubao/kimi
# HAIRFIT_GENERATION_PROVIDER=seedream     # gpt_image/nano_banana/seedream/grok
# 可选覆盖（不填用各厂商默认）：
# HAIRFIT_ANALYSIS_MODEL=glm-5.3flash
# HAIRFIT_GENERATION_MODEL=doubao-seedream-5-0-pro-260628
# HAIRFIT_ANALYSIS_BASE_URL=               # 代理/中转网关，不填走官方
# HAIRFIT_GENERATION_BASE_URL=

# --- LLM keys（analysis 用到哪家填哪家） ---
HAIRFIT_OPENAI_API_KEY=
HAIRFIT_ANTHROPIC_API_KEY=
HAIRFIT_DEEPSEEK_API_KEY=
HAIRFIT_DOUBAO_API_KEY=
HAIRFIT_QWEN_API_KEY=
HAIRFIT_ZHIPU_API_KEY=
HAIRFIT_KIMI_API_KEY=

# --- Image generation keys ---
HAIRFIT_GPT_IMAGE_API_KEY=
HAIRFIT_GEMINI_API_KEY=
HAIRFIT_SEEDREAM_API_KEY=
HAIRFIT_GROK_API_KEY=
