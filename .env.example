# openai/anthropic/deepseek/qwen/zhipu/doubao/kimi/apimart
HAIRFIT_ANALYSIS_PROVIDER=
# openai/gemini/seedream/grok/apimart
HAIRFIT_GENERATION_PROVIDER=

# 不填用各厂商默认（如 gpt-6.1-sol / glm-5.3flash / doubao-seedream-5-0-pro-260628）
