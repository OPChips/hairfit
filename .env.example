HAIRFIT_GENERATION_MODEL=

# 代理/中转网关，默认官方端点
HAIRFIT_ANALYSIS_BASE_URL=
HAIRFIT_GENERATION_BASE_URL=

HAIRFIT_OPENAI_API_KEY=
HAIRFIT_ANTHROPIC_API_KEY=
HAIRFIT_DEEPSEEK_API_KEY=
HAIRFIT_DOUBAO_API_KEY=
HAIRFIT_QWEN_API_KEY=
HAIRFIT_ZHIPU_API_KEY=
HAIRFIT_KIMI_API_KEY=
HAIRFIT_GEMINI_API_KEY=
HAIRFIT_GROK_API_KEY=
